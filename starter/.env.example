# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=
# Optional: OpenAI-compatible endpoint and expected dimensions (0 = accept what the API returns)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=0

# Paths are resolved from the repository root
MANIFEST_PATH=data/manifest.csv
QUESTIONS_PATH=benchmark/questions.jsonl
RESULTS_DIR=results
# dev while developing; switch to both only after the selection rule is fixed
EVALUATION_SPLIT=dev

FIXED_CHUNK_SIZE=500
FIXED_CHUNK_OVERLAP=50
PARAGRAPH_CHUNK_SIZE=700
MIN_PAGE_CHARS=100
MIN_CONTENT_PAGES=30
# USD per 1M tokens, used only for the cost estimate in results/run_summary.json
EMBEDDING_PRICE_PER_1M_TOKENS=
